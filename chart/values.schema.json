{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" }
      }
    },
    "config": {
      "type": "object",
      "required": ["llmProvider"],
      "properties": {
        "llmProvider": { "type": "string", "enum": ["anthropic", "openai"] }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "read": { "$ref": "#/definitions/createFlag" },
        "write": { "$ref": "#/definitions/createFlag" }
      }
    },
    "existingSecret": { "type": "string" },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "createFlag": {
      "type": "object",
      "required": ["create"],
      "properties": { "create": { "type": "boolean" } }
    }
  }
}
